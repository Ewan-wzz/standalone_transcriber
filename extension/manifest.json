{
  "manifest_version": 3,
  "name": "小红书视频下载助手",
  "version": "0.2.0",
  "description": "解析并下载当前小红书视频到指定下载文件夹。",
  "permissions": ["downloads", "storage", "scripting", "tabs"],
  "host_permissions": ["https://*.xiaohongshu.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "下载当前小红书视频",
    "default_popup": "popup.html"
  }
}
